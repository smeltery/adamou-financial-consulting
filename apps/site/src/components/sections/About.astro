---
import { linkedin, linkedIcon } from "../../site/identity";
---

<section class="about" id="about">
  <div class="wrap about-grid">
    <div class="portrait">
      <img
        src="/assets/matt-adamou.jpg"
        alt="Matt Adamou smiling"
        width="751"
        height="751"
        loading="lazy"
      />
      <span>YOUR COACH. YOUR CORNER.</span>
    </div>
    <div>
      <p class="eyebrow">MEET MATT ADAMOU</p>
      <h2>
        Money is personal.
        <br /> Your guidance
        <br /> should be, too.
      </h2>
      <p class="lead">
        Hi, I’m Matt. I’m the financial coach behind Adamou Financial
        Consulting.
      </p>
      <p>
        Afin offers customized financial strategies, personalized budgeting, and
        debt payoff planning for individuals, couples, and small businesses. The
        focus is a long-term partnership built around your goals and financial
        growth.
      </p>
      <div class="inline-links">
        <a href="/contact/">Start a conversation</a>
        <a href={linkedin}>
          <Fragment set:html={linkedIcon} />
          Meet me on LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>
