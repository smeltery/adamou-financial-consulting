{
  "name": "adamou-financial-consulting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun scripts/crawl.ts",
    "format": "prettier --write .",
    "check": "prettier --check . && bunx markdownlint-cli2 && bun scripts/validate.ts && astro check && tsc && bun test tests/*.test.ts && bun run build && bunx --bun playwright test",
    "hooks": "git config core.hooksPath .githooks",
    "preview": "bun scripts/serve.ts",
    "check:visual": "sh scripts/visual.sh"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.3.11",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.6",
    "markdownlint-cli2": "0.18.1",
    "mermaid": "12.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@vercel/analytics": "2.0.1",
    "astro": "7.3.8",
    "canvas-confetti": "^1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": "24.x"
  }
}
