{
  "name": "adamou-financial-consulting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/site dev",
    "build": "bun run --cwd apps/site build",
    "format": "prettier --write .",
    "check": "prettier --check . && bunx markdownlint-cli2 && bun scripts/validate.ts && bun run --cwd apps/site check && bun run --cwd apps/console check",
    "hooks": "git config core.hooksPath .githooks",
    "preview": "cd apps/site && bun scripts/serve.ts",
    "check:visual": "sh scripts/visual.sh",
    "dev:console": "bun run --cwd apps/console dev",
    "build:console": "bun run --cwd apps/console build"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "^0.5.9",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.3.11",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.6",
    "markdownlint-cli2": "0.18.1",
    "mermaid": "12.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
