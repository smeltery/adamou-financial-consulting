---
import "../styles/tool-library.css";
import { calculators } from "../tools/catalog";
import { guides } from "../tools/guides";
import { uiIcon } from "../site/identity";
const categories = [
  "All tools",
  ...new Set(Object.values(guides).map((guide) => guide.category)),
];
---

<section class="wrap tool-library" aria-labelledby="library-title">
  <div class="library-heading">
    <div>
      <p class="eyebrow">CHOOSE YOUR STARTING POINT</p>
      <h2 id="library-title">What would you like to work out?</h2>
    </div>
    <a class="text-link" href="#workspace">
      Use the all-in-one workspace
    </a>
  </div>
  <div class="library-controls" hidden>
    <div
      class="library-categories"
      role="group"
      aria-label="Calculator categories"
    >
      {categories.map((category, index) => (
        <button
          type="button"
          data-category={index ? category : ""}
          aria-pressed={index === 0}
        >
          {category}
        </button>
      ))}
    </div>
    <label class="library-search">
      <Fragment set:html={uiIcon("search")} />
      <span class="sr-only">Find a calculator</span>
      <input
        type="search"
        placeholder="Find a calculator…"
        aria-controls="calculator-library"
      />
    </label>
  </div>
  <p class="micro library-count" role="status" aria-live="polite">
    {calculators.length} calculators · Free to use
  </p>
  <div class="calculator-library" id="calculator-library">
    {calculators.map((tool) => (
      <a href={`/tools/${tool.slug}/`} data-category={guides[tool.id].category}>
        <span class="library-card-top">
          <span class="card-icon">
            <Fragment set:html={uiIcon(guides[tool.id].icon)} />
          </span>
          <span class="micro">{guides[tool.id].category}</span>
        </span>
        <h3>{tool.title}</h3>
        <p>{tool.question}</p>
      </a>
    ))}
  </div>
  <div class="library-empty" hidden>
    <h3>No calculators match yet.</h3>
    <p>Try “savings” or “loan,” or view the full library.</p>
    <button class="button" type="button">
      Show all tools
    </button>
  </div>
</section>
<script>
  import "../client/tool-library";
</script>
