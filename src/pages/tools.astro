---
import { uiIcon } from "../site/identity";

import Closing from "../components/sections/Closing.astro";

import Layout from "../layouts/SiteLayout.astro";
import ToolLibrary from "../components/ToolLibrary.astro";
import CalculatorSuite from "../tools/CalculatorSuite";
---

<Layout
  title="Free Financial Calculators: Budget, Debt & Savings"
  active="tools"
>
  <section class="wrap contact-heading tools-heading">
    <div>
      <p class="eyebrow">THE AFIN TOOLKIT</p>
      <h1>
        A little math.
        <br /> <em>A clearer picture.</em>
      </h1>
      <p class="lead">
        Try twelve everyday financial tools. Change the numbers, explore a
        possibility, and bring your questions to Matt.
      </p>
    </div>
    <aside>
      <span class="card-icon">
        <Fragment set:html={uiIcon("shield")} />
      </span>
      <strong>Yours to explore.</strong>
      <p>
        No account needed. Calculations happen in your browser. Your numbers
        aren’t sent to Matt, stored, or included in analytics.
      </p>
      <span>Planning estimates · Your selected currency</span>
    </aside>
  </section>
  <ToolLibrary />
  <section class="wrap section workspace-heading" id="workspace">
    <p class="eyebrow icon-label">
      <Fragment set:html={uiIcon("tools")} /> YOUR WORKSPACE
    </p>
    <h2>Keep your numbers together.</h2>
    <p class="lead">
      Switch between tools here without losing your inputs. Choose a currency
      once, then explore different questions.
    </p>
  </section>
  <CalculatorSuite client:load />
  <noscript>
    <style is:inline>
      .calculator[hidden] {
        display: block !important;
      }
    </style>
  </noscript>
  <section class="wrap section tool-guide">
    <p class="eyebrow">MAKE THE NUMBERS USEFUL</p>
    <h2>Explore. Compare. Talk it through.</h2>
    <div class="reading-cards">
      <article>
        <span class="card-icon">
          <Fragment set:html={uiIcon("wallet")} />
        </span>
        <h3>Start with a snapshot.</h3>
        <p>
          Replace the examples with your own estimates. Check that all amounts
          use the same time period.
        </p>
      </article>
      <article>
        <span class="card-icon">
          <Fragment set:html={uiIcon("switch")} />
        </span>
        <h3>Change one thing.</h3>
        <p>
          Try a different contribution or monthly payment and see how the
          estimate responds.
        </p>
      </article>
      <article>
        <span class="card-icon">
          <Fragment set:html={uiIcon("conversation")} />
        </span>
        <h3>Add the human context.</h3>
        <p>
          The tools do arithmetic. Matt can discuss how your goals and
          responsibilities fit into a practical plan.
        </p>
      </article>
    </div>
    <p class="micro">
      These educational estimates aren’t personalized financial advice. Review
      the assumptions before using a result for a decision.
    </p>
  </section>
  <Closing />
</Layout>
